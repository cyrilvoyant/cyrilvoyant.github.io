 "identifier": "nice",
 "name": "Compare a forecast with persistence — NICE",
 "alternateName": "Comparer une prévision à la persistance — NICE",
 "description": "NICE divides a forecast’s error by that of persistence: 1 means “as good as persistence”, 0 a perfect forecast. Paste observations and forecasts, choose a horizon, read the result.",
 "url": "https://cyrilvoyant.github.io/methods/nice-metrics.html#try-it",
 "sameAs": [
