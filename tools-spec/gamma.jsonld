 "identifier": "gamma",
 "name": "Displace a forecast and explore the γ-index",
 "alternateName": "Déplacer une prévision et observer l’indice γ",
 "description": "The γ-index judges a forecast with tolerances in space, time and intensity. Displace, delay or bias a synthetic cloud and adjust these tolerances.",
 "url": "https://cyrilvoyant.github.io/methods/gamma-index.html#try-it",
 "sameAs": [
  "https://cyrilvoyant.github.io/methods/gamma-index-fr.html#try-it",
