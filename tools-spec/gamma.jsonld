 "additionalProperty": [
  {
   "@type": "PropertyValue",
   "propertyID": "gm-s",
   "name": "Cloud displaced north by (across its motion) km",
   "alternateName": "Décalage du nuage vers le nord km",
   "value": 2,
   "minValue": 0,
   "maxValue": 6,
   "unitText": "km"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "gm-l",
   "name": "Forecast late (+) or early (−) by min",
   "alternateName": "Retard (+) ou avance (−) min",
   "value": 0,
   "minValue": -30,
   "maxValue": 30,
   "unitText": "min"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "gm-b",
   "name": "Intensity bias W/m²",
   "alternateName": "Biais d’intensité W/m²",
   "value": 0,
   "minValue": -80,
   "maxValue": 80,
   "unitText": "W/m²"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "gm-dta",
   "name": "DTA (distance to agreement), spatial km",
   "alternateName": "DTA (distance to agreement), espace km",
   "description": "distance to agreement: spatial tolerance",
   "value": 2,
   "minValue": 0.5,
   "maxValue": 3,
   "unitText": "km"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "gm-tta",
   "name": "TTA (time to agreement), temporal min",
   "alternateName": "TTA (time to agreement), temps min",
   "description": "time to agreement: temporal tolerance",
   "value": 30,
   "minValue": 5,
   "maxValue": 30,
   "unitText": "min"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "gm-idt",
   "name": "IDT (intensity difference threshold), intensity W/m²",
   "alternateName": "IDT (intensity difference threshold), intensité W/m²",
   "description": "intensity deviation tolerance, for example 50 W/m², calibrated from sensor uncertainty or grid operational limits",
   "value": 50,
   "minValue": 10,
   "maxValue": 100,
   "unitText": "W/m²"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:nuage-decale-de-2-km",
   "name": "Nuage décalé de 2 km",
   "alternateName": "Nuage décalé de 2 km",
   "value": "{\"gm-s\": 2, \"gm-l\": 0, \"gm-b\": 0, \"gm-dta\": 2, \"gm-tta\": 30, \"gm-idt\": 50}"
  },
  {
