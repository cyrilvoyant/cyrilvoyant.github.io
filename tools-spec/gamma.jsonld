   "alternateName": "Biais de 80 W/m²",
   "value": "{\"gm-s\": 0, \"gm-l\": 0, \"gm-b\": 80, \"gm-dta\": 2, \"gm-tta\": 30, \"gm-idt\": 50}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:nuage-decale-de-6-km",
   "name": "Nuage décalé de 6 km",
