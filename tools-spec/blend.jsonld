   "minValue": 1,
   "maxValue": 24,
   "unitText": "dimensionless"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "bl-l",
   "name": "Your λ (weight of the latest value, 0 to 1)",
   "alternateName": "Votre λ (poids de la dernière valeur, de 0 à 1)",
   "value": 0.5,
   "minValue": 0,
   "maxValue": 1,
   "unitText": "dimensionless"
  },
