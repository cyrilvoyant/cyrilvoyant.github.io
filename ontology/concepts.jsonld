    }
   ]
  },
  {
   "@id": "cv:smart-persistence",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "smart-persistence",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Persistance de l'indice de ciel clair"
    },
    {
     "@language": "en",
     "@value": "Smart persistence"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La persistance appliquée à l'indice de ciel clair (SP : persistance de l'indice de ciel clair), plutôt qu'à l'éclairement brut."
    },
    {
     "@language": "en",
     "@value": "Persistence applied to the clear-sky index (SP: persistence of the clear-sky index), rather than to raw irradiance."
    }
   ],
   "skos:altLabel": [
