  {
   "@id": "cv:convex-combination",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "convex-combination",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Combinaison convexe"
    },
    {
     "@language": "en",
     "@value": "Convex combination"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Deux prévisions pesées par des poids positifs de somme 1, calculés sur le passé. Persistance et moyenne : CLIPER. Persistance et persistance cyclique : BLEND."
    },
    {
     "@language": "en",
     "@value": "Two forecasts weighed by positive weights adding up to 1, computed on the past. Persistence and the mean: CLIPER. Persistence and cyclic persistence: BLEND."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "poids positifs de somme 1"
    },
    {
     "@language": "en",
     "@value": "positive weights summing to 1"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:narrower": [
    {
     "@id": "cv:blend"
    },
    {
     "@id": "cv:cliper"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:blend"
    },
    {
     "@id": "cv:cliper"
    },
    {
     "@id": "cv:no-free-lunch"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q2627315"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/persistence-blend.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.apm.2026.116988"
    }
   ]
  },
  {
   "@id": "cv:cliper",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "cliper",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "CLIPER"
    },
    {
     "@language": "en",
     "@value": "CLIPER"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La combinaison convexe de la persistance et de la moyenne. Même idée que BLEND, autre partenaire."
    },
    {
     "@language": "en",
     "@value": "The convex combination of persistence and the mean. Same idea as BLEND, another partner."
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité (poids entre 0 et 1)"
    },
    {
     "@language": "en",
     "@value": "dimensionless (weights between 0 and 1)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:convex-combination"
    }
   ],
   "skos:related": [
