  {
   "@id": "cv:forecasting",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "forecasting",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Prévision et évaluation"
    },
    {
     "@language": "en",
     "@value": "Forecasting and evaluation"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Une erreur n'a de sens que face à une référence : on décrit le signal, on choisit des références simples, on mesure le gain, puis on complexifie si ce gain le justifie."
    },
    {
     "@language": "en",
     "@value": "An error only makes sense against a reference: describe the signal, choose simple references, measure the gain, then add complexity only if the gain justifies it."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "prévision solaire"
    },
    {
     "@language": "en",
     "@value": "solar forecasting"
    }
   ],
   "skos:topConceptOf": {
    "@id": "cv:cv-concepts"
