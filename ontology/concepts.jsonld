  {
   "@id": "cv:alpha-beta",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "alpha-beta",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Rapport α/β"
    },
    {
     "@language": "en",
     "@value": "α/β ratio"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Paramètre propre au tissu : il décrit la sensibilité d'un tissu à la taille de chaque fraction. Plus il est faible, plus le tissu est sensible à la dose par fraction (environ 3,9 Gy pour le rectum)."
    },
    {
     "@language": "en",
     "@value": "A tissue-specific parameter: it describes how sensitive a tissue is to the size of each fraction. The lower it is, the more sensitive the tissue is to the dose per fraction (about 3.9 Gy for the rectum)."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "α/β"
    },
    {
     "@language": "en",
     "@value": "α/β"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "gray (Gy)"
    },
    {
     "@language": "en",
     "@value": "gray (Gy)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:radiotherapy"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:bed"
    },
    {
     "@id": "cv:eqd2"
    },
    {
     "@id": "cv:lq-model"
    },
    {
     "@id": "cv:transition-dose"
    }
   ],
   "rdfs:seeAlso": [
