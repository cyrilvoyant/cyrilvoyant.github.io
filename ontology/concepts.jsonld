  {
   "@id": "cv:cop",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "cop",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Coefficient de performance (COP)"
    },
    {
     "@language": "en",
     "@value": "Coefficient of performance (COP)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La chaleur extraite de la source froide par unité de travail reçu. COP > 1 est normal : ce n'est pas un rendement en pourcentage. Limite de Carnot : le COP maximal d'une machine réversible entre deux sources."
    },
    {
     "@language": "en",
     "@value": "Heat extracted from the cold reservoir per unit of work supplied. COP > 1 is normal: it is not a percentage efficiency. Carnot limit: the maximum COP of a reversible machine between two reservoirs."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "COP"
    },
    {
     "@language": "en",
     "@value": "COP"
    }
   ],
