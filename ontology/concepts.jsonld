     "@id": "https://www.cyrilvoyant.com/stories/tunnel-load-simulator/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/tools/tunnel-load-simulator.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.softx.2026.102946"
    }
   ]
  },
  {
   "@id": "cv:monte-carlo",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "monte-carlo",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Monte Carlo"
    },
    {
     "@language": "en",
     "@value": "Monte Carlo"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Simuler de nombreuses fois avec des tirages aléatoires différents. Plus d'histoires réduisent l'erreur statistique, comme 1/√N pour N histoires ; elles ne corrigent ni une mauvaise géométrie ni de mauvaises données physiques."
    },
    {
     "@language": "en",
     "@value": "Simulating many times with different random draws. More histories reduce the statistical error, as 1/√N for N histories; they correct neither a wrong geometry nor wrong physical data."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "méthode de Monte-Carlo"
    },
    {
     "@language": "fr",
     "@value": "Monte-Carlo"
    },
    {
     "@language": "en",
     "@value": "Monte Carlo method"
    },
    {
     "@language": "en",
     "@value": "Monte-Carlo"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:medical-physics"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:bnct"
    },
    {
     "@id": "cv:cross-section"
    },
    {
     "@id": "cv:mean-free-path"
    },
    {
     "@id": "cv:medical-physics"
    },
    {
     "@id": "cv:percentile-band-p10-p90"
    },
    {
     "@id": "cv:simulated-data"
    },
    {
     "@id": "cv:tls"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q232207"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/neutrons-atmospheriques-bnct/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/atmospheric-neutrons-bnct/"
