     "@id": "cv:mae"
    },
    {
     "@id": "cv:nrmse"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    }
   ]
  },
  {
   "@id": "cv:nice",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "nice",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "NICE"
    },
    {
     "@language": "en",
     "@value": "NICE"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "L'erreur de la prévision divisée par celle de la persistance, aux mêmes dates et au même horizon. 0 : parfaite. 1 : autant d'erreur que la persistance. Au-dessus de 1, on l'écrit « > 1 » : moins bonne que la persistance."
    },
    {
     "@language": "en",
     "@value": "The forecast error divided by that of persistence, at the same dates and horizon. 0: perfect. 1: as much error as persistence. Above 1 it is written “> 1”: worse than persistence."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "NICEᵏ"
    },
    {
     "@language": "fr",
     "@value": "NICEΣ"
    },
    {
     "@language": "fr",
     "@value": "indice NICE"
    },
    {
     "@language": "en",
     "@value": "NICEᵏ"
    },
    {
     "@language": "en",
     "@value": "NICEΣ"
    },
    {
     "@language": "en",
     "@value": "NICE index"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité"
    },
    {
     "@language": "en",
     "@value": "dimensionless"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecast-evaluation"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:artu"
    },
    {
     "@id": "cv:blend"
    },
    {
     "@id": "cv:forecast-evaluation"
    },
    {
     "@id": "cv:horizon"
    },
    {
     "@id": "cv:mae"
    },
    {
     "@id": "cv:nrmse"
    },
    {
     "@id": "cv:persistence"
    },
    {
     "@id": "cv:rmse"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/outils/nice/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/nice-metrics.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.seta.2025.104588"
    }
   ]
  },
  {
   "@id": "cv:scv",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "scv",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "sCV"
    },
    {
     "@language": "en",
     "@value": "sCV"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Indice sans unité d’écart à la courbe de ciel clair, normalisé par l’échelle de cette courbe et le plancher diffus retenu. 0 : ciel clair ; 1 : repère d’une alternance aléatoire équiprobable entre ciel clair et ce plancher, pas une borne supérieure."
    },
    {
     "@language": "en",
     "@value": "A dimensionless departure from the clear-sky curve, normalized by that curve’s scale and the chosen diffuse floor. 0: clear sky; 1: the reference case of equally likely random switching between clear sky and that floor, not an upper bound."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "coefficient de variation stochastique"
    },
    {
     "@language": "en",
     "@value": "stochastic coefficient of variation"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité"
    },
    {
     "@language": "en",
     "@value": "dimensionless"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:clear-sky-index"
    },
    {
     "@id": "cv:forecastability-f"
    },
    {
     "@id": "cv:malr"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/outils/variabilite-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/solar-variability-scv.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.renene.2025.123913"
    }
   ]
  },
  {
   "@id": "cv:forecastability-f",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "forecastability-f",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Prévisibilité F"
    },
    {
     "@language": "en",
     "@value": "Forecastability F"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "F = 1 + sCV × (ρmax − 1), comprise entre 1 − sCV et 1. Plus elle est haute, plus cet horizon est facile à prévoir."
    },
    {
     "@language": "en",
     "@value": "F = 1 + sCV × (ρmax − 1), between 1 − sCV and 1. The higher it is, the easier that horizon is to forecast."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "indicateur F"
    },
    {
     "@language": "fr",
     "@value": "prévisibilité"
    },
    {
     "@language": "en",
     "@value": "F indicator"
    },
    {
     "@language": "en",
     "@value": "forecastability"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité"
    },
    {
     "@language": "en",
     "@value": "dimensionless"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:horizon"
    },
    {
     "@id": "cv:malr"
    },
    {
     "@id": "cv:memory-phi"
    },
    {
     "@id": "cv:scv"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/outils/variabilite-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/solar-variability-scv.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.renene.2025.123913"
    }
   ]
  },
  {
   "@id": "cv:gamma-index",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "gamma-index",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Indice γ"
    },
    {
     "@language": "en",
     "@value": "γ-index"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Pour chaque pixel prévu, la distance à l'observation la plus proche dans l'espace, le temps et l'intensité, chacun divisé par sa tolérance. γ ≤ 1 : accepté."
    },
    {
     "@language": "en",
     "@value": "For each forecast pixel, the distance to the nearest observation in space, time and intensity, each divided by its tolerance. γ ≤ 1: accepted."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "indice gamma"
    },
    {
     "@language": "en",
     "@value": "gamma index"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité"
    },
    {
     "@language": "en",
     "@value": "dimensionless"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecast-evaluation"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:rmse"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/outils/indice-gamma/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/gamma-index.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.ijforecast.2026.03.002"
    }
   ]
  },
  {
   "@id": "cv:brownian-motion",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "brownian-motion",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Mouvement brownien"
    },
    {
     "@language": "en",
     "@value": "Brownian motion"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Chaque valeur est la précédente plus un tirage au hasard : mémoire φ = 1. La persistance y est la meilleure prévision."
    },
    {
     "@language": "en",
     "@value": "Each value is the previous one plus a random draw: memory φ = 1. Persistence wins on it."
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:memory-phi"
    },
    {
     "@id": "cv:persistence"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    }
   ]
  },
  {
   "@id": "cv:memory-phi",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "memory-phi",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Mémoire φ"
    },
    {
     "@language": "en",
     "@value": "Memory φ"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La corrélation entre deux valeurs voisines du bruit. 0 : aucune. 1 : totale."
    },
    {
     "@language": "en",
     "@value": "The correlation between two neighbouring values of the noise. 0: none. 1: total."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "mémoire du bruit"
    },
    {
     "@language": "en",
     "@value": "noise memory"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité (entre 0 et 1)"
    },
    {
     "@language": "en",
     "@value": "dimensionless (between 0 and 1)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:brownian-motion"
    },
