  {
   "@id": "cv:tls",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "tls",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Tunnel Load Simulator (TLS)"
    },
    {
     "@language": "en",
     "@value": "Tunnel Load Simulator (TLS)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Une application open source qui construit la consommation électrique d'un tunnel routier à partir de sa géométrie, du trafic, de l'éclairage et de la ventilation, dit à quel point elle est incertaine et en énonce les limites."
    },
    {
     "@language": "en",
     "@value": "An open-source application that builds the electricity demand of a road tunnel from its geometry, traffic, lighting and ventilation, says how uncertain it is and states its limits."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "TLS"
    },
    {
     "@language": "fr",
     "@value": "simulateur de charge de tunnel"
    },
    {
     "@language": "en",
     "@value": "TLS"
    },
    {
     "@language": "en",
     "@value": "tunnel load simulator"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "MWh par an, kW"
    },
    {
     "@language": "en",
     "@value": "MWh per year, kW"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:simulated-data"
    }
   ],
   "skos:related": [
