  {
   "@id": "cv:cyclic-persistence",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "cyclic-persistence",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Persistance cyclique"
    },
    {
     "@language": "en",
     "@value": "Cyclic persistence"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La prévision recopie la valeur un cycle plus tôt, au même moment du cycle."
    },
    {
     "@language": "en",
     "@value": "The forecast copies the value one cycle earlier, at the same moment of the cycle."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "en",
     "@value": "cyclic persistence"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:blend"
    },
