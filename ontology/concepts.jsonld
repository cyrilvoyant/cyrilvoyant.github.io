     "@language": "fr",
     "@value": "Rendement de Carnot"
    },
    {
     "@language": "en",
     "@value": "Carnot efficiency"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Le rendement η est le travail W divisé par la chaleur reçue Qchaud ; ηCarnot est sa borne, atteinte par un cycle réversible, sans frottement ni écart de température lors des échanges."
    },
    {
     "@language": "en",
     "@value": "Efficiency η is the work W divided by the heat received Qhot; ηCarnot is its limit, reached by a reversible cycle, with no friction and no temperature gap during exchanges."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "moteur de Carnot"
    },
    {
     "@language": "fr",
