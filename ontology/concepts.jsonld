  {
   "@id": "cv:mae",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "mae",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "MAE"
    },
    {
     "@language": "en",
     "@value": "MAE"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "L'erreur absolue moyenne : la moyenne des écarts en valeur absolue entre prévision et observation."
    },
    {
     "@language": "en",
     "@value": "The mean absolute error: the average of the absolute gaps between forecast and observation."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "erreur absolue moyenne"
    },
    {
     "@language": "en",
     "@value": "mean absolute error"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "celle du signal"
    },
    {
     "@language": "en",
     "@value": "same as the signal"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecast-evaluation"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:forecast-evaluation"
    },
    {
     "@id": "cv:nice"
    },
    {
     "@id": "cv:nmae"
    },
    {
     "@id": "cv:rmse"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q6803609"
   },
