  {
   "@id": "cv:medical-physics",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "medical-physics",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Physique médicale"
    },
    {
     "@language": "en",
     "@value": "Medical physics"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Comment un faisceau de photons ou de neutrons traverse la matière et y dépose de l'énergie, des modèles simples aux simulations de transport."
    },
    {
     "@language": "en",
     "@value": "How a beam of photons or neutrons crosses matter and deposits energy in it, from simple models to transport simulations."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "physique des rayonnements"
    },
    {
     "@language": "en",
     "@value": "radiation physics"
    }
   ],
   "skos:topConceptOf": {
    "@id": "cv:cv-concepts"
