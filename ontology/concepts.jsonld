     "@language": "fr",
     "@value": "Congélation"
    },
    {
     "@language": "en",
     "@value": "Freezing"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "L'énergie à retirer pour geler une masse d'eau : chaleur sensible (mcΔT) plus chaleur latente, sans changement de température dans ce modèle ; la puissance moyenne est l'énergie divisée par la durée."
    },
    {
     "@language": "en",
     "@value": "The energy to remove to freeze a mass of water: sensible heat (mcΔT) plus latent heat, with no temperature change in this model; average power is energy divided by duration."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "énergie de congélation"
    },
    {
     "@language": "en",
     "@value": "freezing energy"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "kJ ou MJ ; puissance en kW"
    },
