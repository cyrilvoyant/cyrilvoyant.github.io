   },
   "skos:notation": "half-value-layer",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Couche de demi-atténuation (CDA)"
    },
    {
     "@language": "en",
     "@value": "Half-value layer (HVL)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "L'épaisseur de matériau qui divise par deux l'intensité transmise sans diffusion : CDA = ln 2 / μ, avec μ le coefficient d'atténuation linéique."
    },
    {
     "@language": "en",
     "@value": "The thickness of material that halves the intensity transmitted without scattering: HVL = ln 2 / μ, with μ the linear attenuation coefficient."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "CDA"
    },
