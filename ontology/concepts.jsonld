    }
   ]
  },
  {
   "@id": "cv:mean-free-path",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "mean-free-path",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Libre parcours moyen"
    },
    {
     "@language": "en",
     "@value": "Mean free path"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "L'inverse de la section efficace macroscopique, L = 1/Σ : la distance moyenne entre deux collisions."
    },
    {
     "@language": "en",
     "@value": "The inverse of the macroscopic cross section, L = 1/Σ: the average distance between two collisions."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "L = 1/Σ"
    },
    {
     "@language": "en",
     "@value": "L = 1/Σ"
    }
   ],
   "schema:unitText": [
