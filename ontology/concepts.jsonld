  {
   "@id": "cv:persistence",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "persistence",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Persistance"
    },
    {
     "@language": "en",
     "@value": "Persistence"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La prévision recopie la dernière valeur connue. C'est la référence minimale de toute prévision."
    },
    {
     "@language": "en",
     "@value": "The forecast copies the last known value. It is the minimal reference of any forecast."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "persistance simple"
    },
    {
     "@language": "en",
     "@value": "simple persistence"
    },
    {
     "@language": "en",
     "@value": "naive forecast"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
