  {
   "@id": "cv:mimo",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "mimo",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "MIMO (multi-entrée multi-sortie)"
    },
    {
     "@language": "en",
     "@value": "MIMO (multiple-input multiple-output)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Une architecture multi-entrée multi-sortie : un seul modèle lit l'historique récent de plusieurs signaux et les prévoit ensemble."
    },
    {
     "@language": "en",
     "@value": "A multiple-input multiple-output architecture: one model reads the recent history of several signals and forecasts them together."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "MIMO-ELM"
    },
    {
     "@language": "en",
