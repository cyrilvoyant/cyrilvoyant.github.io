   },
   "skos:notation": "normal-distribution",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Loi normale"
    },
    {
     "@language": "en",
     "@value": "Normal distribution"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Le score z est le nombre d'écarts-types entre x et la moyenne ; Φ(z) est la probabilité qu'une variable normale centrée réduite reste en dessous de z : l'aire à gauche de z."
    },
    {
     "@language": "en",
     "@value": "The z-score is the number of standard deviations between x and the mean; Φ(z) is the probability that a standard normal variable stays below z: the area to the left of z."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "loi de Gauss"
    },
    {
     "@language": "fr",
     "@value": "score z"
    },
    {
     "@language": "en",
     "@value": "Gaussian distribution"
    },
    {
     "@language": "en",
     "@value": "z-score"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "celle de la variable ; z sans unité"
    },
    {
     "@language": "en",
     "@value": "that of the variable; z dimensionless"
    }
   ],
   "skos:broader": [
    {
