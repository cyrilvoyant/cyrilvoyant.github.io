  {
   "@id": "cv:percentile-band-p10-p90",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "percentile-band-p10-p90",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Bande P10–P90"
    },
    {
     "@language": "en",
     "@value": "P10–P90 band"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "P10 et P90 sont les centiles 10 et 90 des résultats simulés : la bande P10–P90 contient les 80 % centraux. Elle décrit la variation entre simulations pour les paramètres choisis, pas toute l'incertitude sur un système réel."
    },
    {
     "@language": "en",
     "@value": "P10 and P90 are the 10th and 90th percentiles of the simulated results: the P10–P90 band contains the central 80 %. It describes variation between runs under the chosen parameters, not all uncertainty about a real system."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "P10 et P90"
    },
    {
     "@language": "fr",
     "@value": "médiane et bande P10–P90"
    },
    {
     "@language": "en",
     "@value": "P10 and P90"
    },
    {
     "@language": "en",
     "@value": "median and P10–P90 band"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "celle de la grandeur simulée"
    },
    {
     "@language": "en",
     "@value": "same as the simulated quantity"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:monte-carlo"
    },
    {
     "@id": "cv:simulated-data"
    },
    {
     "@id": "cv:tls"
    }
   ],
   "rdfs:seeAlso": [
