     "@language": "fr",
     "@value": "Point influent"
    },
    {
     "@language": "en",
     "@value": "Influential point"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Un point qui déplace la droite des moindres carrés ; le levier est son poids potentiel, d'autant plus grand qu'il est loin en x."
    },
    {
     "@language": "en",
     "@value": "A point that moves the least-squares line; leverage is its potential weight, greater the farther it lies in x."
    }
   ],
