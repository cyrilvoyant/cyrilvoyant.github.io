   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/animations/test-student/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/tools/student-t-test/"
    }
   ]
  },
  {
   "@id": "cv:student-t-test",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "student-t-test",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Test de Student"
    },
    {
     "@language": "en",
     "@value": "Student t-test"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Le test divise l'écart entre deux moyennes par son erreur standard : un même écart peut se détacher du hasard d'échantillonnage, ou s'y noyer. Significatif ne veut pas dire important."
    },
    {
     "@language": "en",
     "@value": "The test divides the difference between two means by its standard error: the same difference can stand out from sampling chance or drown in it. Significant does not mean important."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "test t"
    },
    {
     "@language": "en",
     "@value": "t-test"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité (t)"
    },
    {
     "@language": "en",
     "@value": "dimensionless (t)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:statistics"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:confidence-interval"
    },
    {
     "@id": "cv:p-value"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q309479"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/animations/test-student/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/tools/student-t-test/"
    }
   ]
  },
  {
   "@id": "cv:chi-square-test",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "chi-square-test",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Test du χ²"
    },
    {
     "@language": "en",
     "@value": "Chi-square test"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La statistique est la somme des contributions (O−E)²/E, avec O l'effectif observé et E l'effectif attendu sous l'hypothèse testée. Une petite p-value dit que l'écart est peu compatible avec l'hypothèse, pas qu'il est grand."
    },
    {
     "@language": "en",
     "@value": "The statistic is the sum of the contributions (O−E)²/E, with O the observed count and E the count expected under the tested hypothesis. A small p-value says the departure is hardly compatible with the hypothesis, not that it is large."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "test du khi-deux"
    },
    {
     "@language": "fr",
     "@value": "χ²"
    },
    {
     "@language": "en",
     "@value": "chi-squared test"
    },
    {
     "@language": "en",
     "@value": "χ²"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité"
    },
    {
     "@language": "en",
     "@value": "dimensionless"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:statistics"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:p-value"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q1071004"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/animations/test-khi-deux/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/tools/chi-square-test/"
    }
   ]
  },
  {
   "@id": "cv:normal-distribution",
   "@type": "skos:Concept",
   "skos:inScheme": {
