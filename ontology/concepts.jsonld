    },
    {
     "@id": "https://www.cyrilvoyant.com/tools/compton-scattering/"
    }
   ]
  },
  {
   "@id": "cv:attenuation",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "attenuation",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Atténuation"
    },
    {
     "@language": "en",
     "@value": "Attenuation"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Chaque épaisseur égale à la couche de demi-atténuation divise par deux ce qui reste : c'est une décroissance exponentielle, pas une soustraction."
    },
    {
     "@language": "en",
     "@value": "Each thickness equal to the half-value layer halves what remains: it is an exponential decay, not a subtraction."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "décroissance exponentielle"
    },
    {
     "@language": "en",
     "@value": "exponential decay"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité (fraction transmise)"
    },
    {
     "@language": "en",
     "@value": "dimensionless (transmitted fraction)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:medical-physics"
    }
   ],
