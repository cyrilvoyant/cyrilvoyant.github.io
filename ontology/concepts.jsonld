  {
   "@id": "cv:macroscopic-cross-section",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "macroscopic-cross-section",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Section efficace macroscopique"
    },
    {
     "@language": "en",
     "@value": "Macroscopic cross section"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La section efficace multipliée par le nombre de noyaux par unité de volume : l'inverse d'une longueur. Pour un mélange, Σ additionne ces produits noyau par noyau."
    },
    {
     "@language": "en",
     "@value": "The cross section multiplied by the number of nuclei per unit volume: an inverse length. For a mixture, Σ adds these products nucleus by nucleus."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "Σ"
    },
    {
     "@language": "en",
     "@value": "Σ"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "inverse d'une longueur (cm⁻¹)"
    },
    {
     "@language": "en",
     "@value": "inverse length (cm⁻¹)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:medical-physics"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:cross-section"
    },
    {
     "@id": "cv:mean-free-path"
    }
   ],
