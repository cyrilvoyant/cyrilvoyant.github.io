     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    }
   ]
  },
  {
   "@id": "cv:ratio-to-trend",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "ratio-to-trend",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Rapport à la tendance"
    },
    {
     "@language": "en",
     "@value": "Ratio to trend"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "On étudie y / c, avec ici une tendance périodique c. Adapté à un bruit multiplicatif. Avec c le ciel clair : l'indice de ciel clair."
    },
    {
     "@language": "en",
     "@value": "We study y / c. Suited to multiplicative noise. With c as clear sky: the clear-sky index."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "en",
     "@value": "ratio to trend"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité"
    },
    {
     "@language": "en",
     "@value": "dimensionless"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
