    }
   ]
  },
  {
   "@id": "cv:fractionation",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "fractionation",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Fractionnement"
    },
    {
     "@language": "en",
     "@value": "Fractionation"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Pour n fractions (le nombre de séances), chacune délivrant une dose d en grays, la dose physique ne suffit pas à prédire l'effet biologique, qui dépend aussi de la dose reçue à chaque fraction."
    },
    {
     "@language": "en",
     "@value": "For n fractions (the number of treatment sessions), each delivering a dose d in grays, physical dose is not enough to predict the biological effect, which also depends on the dose received at each fraction."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "fractions"
    },
    {
     "@language": "fr",
     "@value": "schéma de traitement"
    },
    {
     "@language": "en",
     "@value": "fractions"
    },
    {
     "@language": "en",
     "@value": "treatment schedule"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "n fractions de d Gy"
    },
    {
     "@language": "en",
     "@value": "n fractions of d Gy"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:radiotherapy"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:bed"
    },
