  {
   "@id": "cv:deseasonalization",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "deseasonalization",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Désaisonnalisation"
    },
    {
     "@language": "en",
     "@value": "Deseasonalization"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Un cycle connu ne se prévoit pas : on le retire, on prévoit le reste, on le remet."
    },
    {
     "@language": "en",
     "@value": "A known cycle is not forecast: remove it, forecast the rest, put it back."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "retrait du cycle"
    },
    {
     "@language": "en",
     "@value": "removing the cycle"
    },
    {
     "@language": "en",
     "@value": "seasonal adjustment"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:ar2"
    },
    {
     "@id": "cv:difference-to-trend"
    },
    {
     "@id": "cv:ratio-to-trend"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q622893"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/make-stationary.html"
    }
   ]
  },
  {
   "@id": "cv:rmse",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "rmse",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "RMSE"
    },
    {
     "@language": "en",
     "@value": "RMSE"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La racine de l'erreur quadratique moyenne. Elle donne plus de poids aux grandes erreurs que la MAE."
    },
    {
     "@language": "en",
     "@value": "The root mean squared error. It gives large errors more weight than the MAE."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "racine de l'erreur quadratique moyenne"
    },
    {
     "@language": "en",
     "@value": "root mean squared error"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "celle du signal (W/m² pour l'éclairement)"
    },
    {
     "@language": "en",
     "@value": "same as the signal (W/m² for irradiance)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecast-evaluation"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:forecast-evaluation"
    },
    {
     "@id": "cv:gamma-index"
    },
    {
     "@id": "cv:mae"
    },
    {
     "@id": "cv:nice"
    },
    {
     "@id": "cv:nrmse"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q29037"
   },
   "rdfs:seeAlso": [
