  {
   "@id": "cv:horizon",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "horizon",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Horizon de prévision"
    },
    {
     "@language": "en",
     "@value": "Forecast horizon"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Le nombre de pas entre la dernière valeur connue et la valeur à prévoir."
    },
    {
     "@language": "en",
     "@value": "The number of steps between the last known value and the value to forecast."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "horizon"
    },
    {
     "@language": "en",
     "@value": "horizon"
    }
   ],
