  {
   "@id": "cv:radiotherapy",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "radiotherapy",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Radiothérapie"
    },
    {
     "@language": "en",
     "@value": "Radiotherapy"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Quand le lien entre un schéma de radiothérapie et son effet biologique est connu, on le calcule directement avec un modèle explicite, sans données d'apprentissage."
    },
    {
     "@language": "en",
     "@value": "When the link between a radiotherapy schedule and its biological effect is known, it is computed directly with an explicit model, with no training data."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "dose biologique"
    },
    {
     "@language": "en",
     "@value": "biological dose"
    }
   ],
   "skos:topConceptOf": {
    "@id": "cv:cv-concepts"
