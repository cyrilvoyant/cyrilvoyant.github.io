  {
   "@id": "cv:blend",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "blend",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "BLEND"
    },
    {
     "@language": "en",
     "@value": "BLEND"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La combinaison convexe de la persistance et de la persistance cyclique : deux poids positifs de somme 1, λ et 1 − λ, calculés à chaque moment du cycle."
    },
    {
     "@language": "en",
     "@value": "The convex combination of persistence and cyclic persistence: two positive weights adding up to 1, λ and 1 − λ, computed at each moment of the cycle."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "persistance cyclostationnaire"
    },
    {
     "@language": "en",
     "@value": "cyclostationary persistence"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité (poids entre 0 et 1)"
    },
    {
     "@language": "en",
     "@value": "dimensionless (weights between 0 and 1)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:convex-combination"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:cliper"
    },
    {
     "@id": "cv:convex-combination"
    },
    {
     "@id": "cv:cyclic-persistence"
    },
    {
     "@id": "cv:nice"
    },
    {
     "@id": "cv:persistence"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/outils/blend/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/persistence-blend.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.apm.2026.116988"
    }
   ]
  },
  {
   "@id": "cv:artu",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "artu",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "ARTU"
    },
    {
     "@language": "en",
     "@value": "ARTU"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Une référence d'ordre deux sur le rapport à la tendance : deux autocorrélations et une table donnent ses trois poids, sur la dernière valeur, la valeur h pas plus tôt et la moyenne."
    },
    {
     "@language": "en",
     "@value": "A second-order reference on the ratio to trend: two autocorrelations and a table give its three weights, on the last value, the value h steps earlier and the mean."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "en",
     "@value": "second-order reference"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité (poids)"
    },
    {
     "@language": "en",
     "@value": "dimensionless (weights)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:cliper"
    },
    {
     "@id": "cv:nice"
    },
    {
     "@id": "cv:persistence"
    },
    {
     "@id": "cv:ratio-to-trend"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/outils/artu/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/teaching/artu-worked-example.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.renene.2022.04.065"
    }
   ]
  },
  {
   "@id": "cv:ar2",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "ar2",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "AR(2)"
    },
    {
     "@language": "en",
     "@value": "AR(2)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Une régression sur les deux dernières valeurs connues. Brute : sans retirer le cycle. Elle sert à mesurer ce que le retrait du cycle rapporte."
    },
    {
     "@language": "en",
     "@value": "A regression on the last two known values. Raw: without removing the cycle. It measures what removing the cycle brings."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "autorégression d'ordre 2"
    },
    {
     "@language": "en",
     "@value": "second-order autoregression"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:deseasonalization"
    },
    {
     "@id": "cv:elm"
    },
    {
     "@id": "cv:persistence"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/solar-forecasting-made-simple.html"
    }
   ]
  },
  {
   "@id": "cv:elm",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "elm",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Extreme Learning Machine (ELM)"
    },
    {
     "@language": "en",
     "@value": "Extreme learning machine (ELM)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Une Extreme Learning Machine garde une couche cachée aléatoire et ajuste les sorties par une résolution analytique, ce qui évite un entraînement profond itératif."
    },
    {
     "@language": "en",
     "@value": "The Extreme Learning Machine retains a random hidden layer and fits its output coefficients analytically, avoiding iterative deep-network training."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "ELM"
    },
    {
     "@language": "fr",
     "@value": "apprentissage frugal"
    },
    {
     "@language": "en",
     "@value": "ELM"
    },
    {
     "@language": "en",
     "@value": "frugal learner"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:ar2"
    },
    {
     "@id": "cv:mimo"
    },
    {
     "@id": "cv:persistence"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q21948731"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/methods/pv-elm.html"
    }
   ],
   "dcterms:source": [
