   },
   "skos:notation": "thermal-physics",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Thermique et thermodynamique"
    },
    {
     "@language": "en",
     "@value": "Thermal physics and thermodynamics"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Échanges de chaleur, cycles moteurs et frigorifiques et limites de Carnot, pour dimensionner un refroidissement, une congélation ou une machine thermique."
    },
    {
     "@language": "en",
     "@value": "Heat exchange, engine and refrigeration cycles and Carnot limits, to size a cooling, a freezing or a heat engine."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "thermique industrielle"
    },
    {
     "@language": "en",
     "@value": "industrial thermal physics"
    }
   ],
