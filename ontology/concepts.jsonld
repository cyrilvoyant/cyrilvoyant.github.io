  {
   "@id": "cv:difference-to-trend",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "difference-to-trend",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Différence à la tendance"
    },
    {
     "@language": "en",
     "@value": "Difference to trend"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "On étudie y − c, l'écart à la tendance c (ici périodique). Adapté à un bruit additif."
    },
    {
     "@language": "en",
     "@value": "We study y − c, the gap to the cycle c. Suited to additive noise."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "en",
     "@value": "difference to trend"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "celle du signal"
    },
    {
     "@language": "en",
     "@value": "same as the signal"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:deseasonalization"
    },
    {
     "@id": "cv:ratio-to-trend"
    }
   ],
