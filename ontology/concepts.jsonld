  {
   "@id": "cv:lq-model",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "lq-model",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Modèle linéaire-quadratique (LQ)"
    },
    {
     "@language": "en",
     "@value": "Linear-quadratic model (LQ)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La BED d'une fraction croît en courbe avec la dose, à toutes les doses : la courbe LQ continue de s'infléchir vers le haut quand la dose par fraction augmente."
    },
    {
     "@language": "en",
     "@value": "The BED of a fraction grows along a curve with dose, at all doses: the LQ curve keeps bending upward as the dose per fraction grows."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "LQ"
    },
    {
     "@language": "en",
     "@value": "LQ"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:radiotherapy"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:alpha-beta"
    },
    {
     "@id": "cv:bed"
    },
    {
     "@id": "cv:lql-equiv"
    },
    {
     "@id": "cv:lql-model"
    },
    {
     "@id": "cv:radiotherapy"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/outils/doses-lq-lql/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/lql-equiv/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/tools/lql-equiv.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.clon.2025.103893"
    },
    {
     "@id": "https://doi.org/10.1016/j.rpor.2013.08.004"
    }
   ]
  },
  {
   "@id": "cv:lql-model",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "lql-model",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Modèle linéaire-quadratique-linéaire (LQL)"
    },
    {
     "@language": "en",
     "@value": "Linear-quadratic-linear model (LQL)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La même courbe que le LQ jusqu'à la dose de transition, puis une droite. Sous la dose de transition, les deux modèles sont identiques."
    },
    {
     "@language": "en",
     "@value": "The same curve as LQ up to the transition dose, then a straight line. Below the transition dose, the two models are identical."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "LQL"
    },
    {
     "@language": "en",
     "@value": "LQL"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:radiotherapy"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:bed"
    },
    {
     "@id": "cv:lq-model"
    },
    {
     "@id": "cv:lql-equiv"
    },
    {
     "@id": "cv:transition-dose"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/outils/doses-lq-lql/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/lql-equiv/"
    },
    {
     "@id": "https://cyrilvoyant.github.io/tools/lql-equiv.html"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.clon.2025.103893"
    },
    {
     "@id": "https://doi.org/10.1016/j.softx.2026.103085"
    }
   ]
  },
  {
   "@id": "cv:bed",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "bed",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Dose biologique efficace (BED)"
    },
    {
     "@language": "en",
     "@value": "Biologically effective dose (BED)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Dose en grays qui permet de comparer des fractionnements différents. Pour n fractions de dose d, le modèle LQ donne BED = n · d · (1 + d / (α/β))."
    },
    {
     "@language": "en",
     "@value": "Dose in grays that makes different fractionations comparable. For n fractions of dose d, the LQ model gives BED = n · d · (1 + d / (α/β))."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "BED"
    },
    {
     "@language": "fr",
     "@value": "dose biologiquement efficace"
    },
    {
     "@language": "en",
     "@value": "BED"
    },
    {
     "@language": "en",
     "@value": "biological effective dose"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "gray (Gy)"
    },
    {
     "@language": "en",
     "@value": "gray (Gy)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:radiotherapy"
    }
   ],
   "skos:related": [
