  {
   "@id": "cv:p-value",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "p-value",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "p-value"
    },
    {
     "@language": "en",
     "@value": "p-value"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La probabilité, si les moyennes sont égales (ou ρ = 0) et le modèle correct, d'un résultat au moins aussi extrême. Ce n'est pas la probabilité que l'hypothèse soit vraie ; elle ne mesure pas l'importance d'un lien."
    },
    {
     "@language": "en",
     "@value": "The probability, if the means are equal (or ρ = 0) and the model is correct, of a result at least as extreme. It is not the probability that the hypothesis is true; it does not measure the importance of an association."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "valeur p"
    },
    {
     "@language": "en",
     "@value": "p value"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité (entre 0 et 1)"
    },
    {
     "@language": "en",
     "@value": "dimensionless (between 0 and 1)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:statistics"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:chi-square-test"
    },
    {
     "@id": "cv:normal-distribution"
    },
    {
