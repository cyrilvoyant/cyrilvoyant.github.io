    }
   ]
  },
  {
   "@id": "cv:gray",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "gray",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Gray (Gy)"
    },
    {
     "@language": "en",
     "@value": "Gray (Gy)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "L'unité de dose physique absorbée : l'énergie déposée par kilogramme de tissu."
    },
    {
     "@language": "en",
     "@value": "The unit of absorbed physical dose: the energy deposited per kilogram of tissue."
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "J/kg"
    },
    {
     "@language": "en",
     "@value": "J/kg"
    }
   ],
   "skos:broader": [
