  {
   "@id": "cv:statistics",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "statistics",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Statistiques"
    },
    {
     "@language": "en",
     "@value": "Statistics"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Comparer un écart à son incertitude, mesurer une relation ou une prédiction, et lire un résultat sans le surinterpréter."
    },
    {
     "@language": "en",
     "@value": "Compare a difference with its uncertainty, measure an association or a prediction, and read a result without over-interpreting it."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "biostatistique"
    },
    {
     "@language": "en",
