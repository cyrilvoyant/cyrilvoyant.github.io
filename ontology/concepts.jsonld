    }
   ]
  },
  {
   "@id": "cv:nrmse",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "nrmse",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "nRMSE"
    },
    {
     "@language": "en",
     "@value": "nRMSE"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La RMSE rapportée à la moyenne du signal (0 pour une prévision parfaite)."
    },
    {
     "@language": "en",
     "@value": "The RMSE divided by the mean of the signal (0 for a perfect forecast)."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "RMSE normalisée"
    },
    {
     "@language": "en",
     "@value": "normalized RMSE"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité (souvent en %)"
    },
    {
     "@language": "en",
     "@value": "dimensionless (often in %)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecast-evaluation"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:nice"
    },
    {
     "@id": "cv:nmae"
    },
    {
     "@id": "cv:rmse"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    }
   ]
  },
  {
   "@id": "cv:nmae",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "nmae",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "nMAE"
    },
    {
     "@language": "en",
     "@value": "nMAE"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "L'erreur absolue moyenne rapportée à la moyenne du signal."
    },
    {
     "@language": "en",
     "@value": "The mean absolute error divided by the mean of the signal."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "MAE normalisée"
    },
    {
     "@language": "en",
