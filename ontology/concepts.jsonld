    {
     "@language": "fr",
     "@value": "Il encadre une nouvelle observation en x₀ : on ajoute 1 sous la racine, d'où une bande plus large que l'intervalle de confiance."
    },
    {
     "@language": "en",
     "@value": "It brackets a new observation at x₀: add 1 under the root, hence a band wider than the confidence interval."
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "celle de y"
    },
    {
     "@language": "en",
     "@value": "same as y"
    }
   ],
