  {
   "@id": "cv:clear-sky-index",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "clear-sky-index",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Indice de ciel clair"
    },
    {
     "@language": "en",
     "@value": "Clear-sky index"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "En solaire, le rapport à la tendance de ciel clair : l'éclairement divisé par l'éclairement de ciel clair."
    },
    {
     "@language": "en",
     "@value": "In solar forecasting, the ratio to the clear-sky trend: irradiance divided by clear-sky irradiance."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "rapport à la tendance de ciel clair"
    },
    {
     "@language": "en",
     "@value": "ratio to the clear-sky trend"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité"
    },
    {
     "@language": "en",
     "@value": "dimensionless"
    }
   ],
