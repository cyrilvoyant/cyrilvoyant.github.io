  {
   "@id": "cv:compton-effect",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "compton-effect",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Effet Compton"
    },
    {
     "@language": "en",
     "@value": "Compton scattering"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La diffusion d'un photon sur un électron : le photon perd de l'énergie et l'électron reçoit une énergie cinétique K. L'énergie au repos de l'électron est 511 keV."
    },
    {
     "@language": "en",
     "@value": "The scattering of a photon on an electron: the photon loses energy and the electron receives a kinetic energy K. The rest energy of the electron is 511 keV."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "diffusion Compton"
    },
    {
     "@language": "en",
     "@value": "Compton effect"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "keV"
    },
    {
     "@language": "en",
     "@value": "keV"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:medical-physics"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:attenuation"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q171516"
   },
