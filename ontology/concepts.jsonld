  {
   "@id": "cv:malr",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "malr",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "MALR (mean absolute log return)"
    },
    {
     "@language": "en",
     "@value": "MALR (mean absolute log return)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Un paramètre issu de l'économétrie qui décrit l'amplitude des changements relatifs. Ce diagnostic empirique ne dispense pas de tester le modèle sur le site et à l'horizon visés."
    },
    {
     "@language": "en",
     "@value": "A parameter borrowed from econometrics that describes the size of relative changes. This empirical diagnostic does not replace testing the model at the intended site and horizon."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "rendement logarithmique absolu moyen"
    },
    {
     "@language": "en",
     "@value": "mean absolute log return"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "sans unité"
    },
    {
     "@language": "en",
     "@value": "dimensionless"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:forecastability-f"
    },
    {
     "@id": "cv:scv"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.energy.2015.07.089"
    }
   ]
  },
  {
   "@id": "cv:no-free-lunch",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "no-free-lunch",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "« No free lunch »"
    },
    {
     "@language": "en",
     "@value": "“No free lunch”"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Sous une moyenne uniforme sur l'ensemble des fonctions d'un problème fini, les performances moyennes des algorithmes de recherche considérés coïncident. Ce cadre précis n'est pas la distribution des problèmes solaires réels."
    },
    {
     "@language": "en",
     "@value": "Under a uniform average over all functions of a finite problem, the average performance of the search algorithms considered coincides. This precise framework is not the distribution of real solar problems."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "théorèmes de no free lunch"
    },
    {
     "@language": "en",
     "@value": "no free lunch theorems"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:convex-combination"
    },
    {
     "@id": "cv:persistence"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q255847"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"
    }
   ]
  },
  {
   "@id": "cv:simulated-data",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "simulated-data",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Données simulées"
    },
    {
     "@language": "en",
     "@value": "Simulated data"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Quand on n'a pas encore de mesures, aucun modèle ne peut être entraîné ni validé, mais on peut simuler ce que l'on sait : une première estimation, pas une mesure."
    },
    {
     "@language": "en",
     "@value": "When there are no measurements yet, no model can be trained or validated, but what is known can be simulated: a first estimate, not a measurement."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "données synthétiques"
    },
    {
     "@language": "en",
     "@value": "synthetic data"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:narrower": [
    {
     "@id": "cv:tls"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:monte-carlo"
    },
    {
     "@id": "cv:percentile-band-p10-p90"
    },
    {
     "@id": "cv:tls"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q7662746"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/tunnel-load-simulator/"
    },
