    },
    {
     "@id": "cv:nice"
    },
    {
     "@id": "cv:persistence"
    },
    {
     "@id": "cv:rmse"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/evaluer-prevision-solaire-persistance/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/evaluate-solar-forecast-persistence/"
