  {
   "@id": "cv:eqd2",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "eqd2",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Dose équivalente en fractions de 2 Gy (EQD2)"
    },
    {
     "@language": "en",
     "@value": "Equivalent dose in 2 Gy fractions (EQD2)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La traduction de la BED en une dose délivrée par fractions de 2 Gy : EQD2 = BED / (1 + 2/(α/β))."
    },
    {
     "@language": "en",
     "@value": "The translation of the BED into a dose given in 2 Gy fractions: EQD2 = BED / (1 + 2/(α/β))."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "EQD2"
    },
    {
     "@language": "en",
     "@value": "EQD2"
    }
