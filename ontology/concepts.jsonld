  {
   "@id": "cv:climatological-mean",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "climatological-mean",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Moyenne"
    },
    {
     "@language": "en",
     "@value": "Mean"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La prévision vaut toujours la moyenne du passé."
    },
    {
     "@language": "en",
     "@value": "The forecast is always the mean of the past."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "moyenne du passé"
    },
    {
     "@language": "fr",
     "@value": "moyenne climatologique"
    },
    {
     "@language": "en",
     "@value": "mean of the past"
    },
    {
     "@language": "en",
     "@value": "climatological mean"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:related": [
