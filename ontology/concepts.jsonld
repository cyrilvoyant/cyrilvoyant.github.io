  {
   "@id": "cv:bnct",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "bnct",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "BNCT (thérapie par capture neutronique du bore)"
    },
    {
     "@language": "en",
     "@value": "BNCT (boron neutron capture therapy)"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Un composé transporte du bore-10 vers les tissus visés ; quand ce bore capture un neutron, une particule alpha et un noyau de lithium-7 déposent leur énergie sur quelques micromètres."
    },
    {
     "@language": "en",
     "@value": "A compound carries boron-10 to the target tissue; when this boron captures a neutron, an alpha particle and a lithium-7 nucleus deposit their energy over a few micrometres."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "thérapie par capture neutronique du bore"
    },
    {
     "@language": "en",
     "@value": "boron neutron capture therapy"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:medical-physics"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:cross-section"
    },
    {
     "@id": "cv:monte-carlo"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q71676169"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/neutrons-atmospheriques-bnct/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/atmospheric-neutrons-bnct/"
    }
   ],
   "dcterms:source": [
    {
     "@id": "https://doi.org/10.1016/j.rpor.2010.11.002"
    }
   ]
  },
  {
   "@id": "cv:cross-section",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "cross-section",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Section efficace"
    },
    {
     "@language": "en",
     "@value": "Cross section"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Elle dit à quel point un noyau réagit facilement avec un neutron d'énergie E. Elle s'exprime comme une surface, souvent en barns, sans être la taille du noyau ni, à elle seule, la probabilité de capture."
    },
    {
     "@language": "en",
     "@value": "It says how readily a nucleus reacts with a neutron of energy E. It is expressed as an area, often in barns, without being the size of the nucleus or, by itself, the probability of capture."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "σ(E)"
    },
    {
     "@language": "en",
     "@value": "neutron cross section"
    },
    {
     "@language": "en",
     "@value": "σ(E)"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "barn (surface)"
    },
    {
     "@language": "en",
     "@value": "barn (area)"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:medical-physics"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:bnct"
    },
    {
     "@id": "cv:macroscopic-cross-section"
    },
    {
     "@id": "cv:mean-free-path"
    },
    {
     "@id": "cv:monte-carlo"
    }
   ],
   "skos:exactMatch": {
    "@id": "http://www.wikidata.org/entity/Q751259"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://www.cyrilvoyant.com/fr/recits/neutrons-atmospheriques-bnct/"
    },
    {
     "@id": "https://www.cyrilvoyant.com/stories/atmospheric-neutrons-bnct/"
    }
   ],
