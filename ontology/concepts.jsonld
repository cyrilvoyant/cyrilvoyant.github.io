  {
   "@id": "cv:transition-dose",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "transition-dose",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Dose de transition dT"
    },
    {
     "@language": "en",
     "@value": "Transition dose dT"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "La dose par fraction où le modèle LQL passe de la courbe à la droite (7,8 Gy pour le rectum). Dans la bibliothèque de LQL-Equiv, elle vaut 2 α/β."
    },
    {
     "@language": "en",
     "@value": "The dose per fraction at which the LQL model changes from a curve to a straight line (7.8 Gy for the rectum). In the LQL-Equiv library it equals 2 α/β."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "dT"
    },
    {
     "@language": "en",
     "@value": "dT"
    }
   ],
   "schema:unitText": [
    {
     "@language": "fr",
     "@value": "gray (Gy)"
    },
    {
     "@language": "en",
     "@value": "gray (Gy)"
    }
   ],
   "skos:broader": [
