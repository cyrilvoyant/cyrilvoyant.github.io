  {
   "@id": "cv:lql-equiv",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "lql-equiv",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "LQL-Equiv"
    },
    {
     "@language": "en",
     "@value": "LQL-Equiv"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Un calculateur gratuit et open source (MIT) de BED et d'EQD2 avec les modèles LQ et LQL, dans le navigateur. Outil de recherche et d'enseignement, pas un dispositif médical."
    },
    {
     "@language": "en",
     "@value": "A free, open-source (MIT) calculator of BED and EQD2 under the LQ and LQL models, in the browser. A research and teaching tool, not a medical device."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "calculateur de BED et d'EQD2"
    },
    {
     "@language": "en",
     "@value": "BED and EQD2 calculator"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:radiotherapy"
    }
   ],
   "skos:related": [
    {
     "@id": "cv:bed"
    },
