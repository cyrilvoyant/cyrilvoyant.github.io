  {
   "@id": "cv:forecast-evaluation",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "cv:cv-concepts"
   },
   "skos:notation": "forecast-evaluation",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Évaluation d'une prévision"
    },
    {
     "@language": "en",
     "@value": "Forecast evaluation"
    }
   ],
   "skos:definition": [
    {
     "@language": "fr",
     "@value": "Une erreur n'a de sens que face à une référence : mêmes cibles, périmètre annoncé, plusieurs normes d'erreur, puis un test de la différence."
    },
    {
     "@language": "en",
     "@value": "An error only makes sense against a reference: same targets, stated scope, several error norms, then a test of the difference."
    }
   ],
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "vérification d'une prévision"
    },
    {
     "@language": "en",
     "@value": "forecast verification"
    }
   ],
   "skos:broader": [
    {
     "@id": "cv:forecasting"
    }
   ],
   "skos:narrower": [
    {
     "@id": "cv:gamma-index"
    },
    {
     "@id": "cv:mae"
    },
    {
     "@id": "cv:nice"
    },
    {
     "@id": "cv:nmae"
    },
    {
     "@id": "cv:nrmse"
    },
    {
     "@id": "cv:rmse"
    }
   ],
   "skos:related": [
